# Скопируйте в .env и подставьте свои значения (файл .env в git не попадает).
# Апстрим — любой OpenAI-совместимый сервер (llama.cpp, vLLM и т.п.).
LLAMA_API_KEY=замените-на-свой-ключ
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_MODEL=qwen3.5-122b
PORT=5013
# необязательно: путь к ruff для линта сгенерированного кода
# RUFF=/путь/к/ruff
