+"""
+Статистика активности репозитория по списку коммитов (без AI).
+
+Чистые функции: принимают коммиты в формате github_repo.get_commits
+({hash, date, author, ...}) и считают топ авторов, коммиты по дням и самый активный день.
+"""
+
+from collections import Counter
+
+
+def compute_stats(commits: list[dict], top: int = 5) -> dict:
+    """Топ авторов, число коммитов по дням (по возрастанию даты) и самый активный день."""
+    authors = Counter(c.get("author") or "?" for c in commits)
+    days = Counter(c["date"] for c in commits if c.get("date"))
+    busiest = None
+    if days:
+        # при равенстве берём более раннюю дату — результат детерминирован
+        day, count = min(days.items(), key=lambda kv: (-kv[1], kv[0]))
+        busiest = {"date": day, "commits": count}
+    return {
+        "total_commits": len(commits),
+        "top_authors": [{"author": a, "commits": n}
+                        for a, n in sorted(authors.items(), key=lambda kv: (-kv[1], kv[0]))[:top]],
+        "commits_by_day": [{"date": d, "commits": days[d]} for d in sorted(days)],
+        "busiest_day": busiest,
+    }
