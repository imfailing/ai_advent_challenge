+"""Проверка эндпоинта /stats и activity.compute_stats (без сети и без AI)."""
+
+import activity
+import app as app_module
+import github_repo
+
+COMMITS = [
+    {"hash": "a", "date": "2026-01-02", "author": "Bob"},
+    {"hash": "b", "date": "2026-01-01", "author": "Alice"},
+    {"hash": "c", "date": "2026-01-02", "author": "Alice"},
+    {"hash": "d", "date": "2026-01-02", "author": "Alice"},
+]
+
+
+def main() -> None:
+    s = activity.compute_stats(COMMITS, top=1)
+    assert s["total_commits"] == 4
+    assert s["top_authors"] == [{"author": "Alice", "commits": 3}]
+    assert s["commits_by_day"] == [{"date": "2026-01-01", "commits": 1},
+                                   {"date": "2026-01-02", "commits": 3}]
+    assert s["busiest_day"] == {"date": "2026-01-02", "commits": 3}
+    print("✅ compute_stats: авторы, дни, самый активный день")
+
+    github_repo.get_commits = lambda repo, last=15, token="": COMMITS
+    client = app_module.app.test_client()
+    r = client.post("/stats", json={"repo": "https://github.com/o/r"})
+    assert r.status_code == 200 and r.get_json()["source"] == "o/r"
+    assert r.get_json()["busiest_day"]["commits"] == 3
+    assert client.post("/stats", json={}).status_code == 400
+    assert client.post("/stats", json={"repo": "o/r", "last": "x"}).status_code == 400
+    print("✅ /stats: успех и ошибки 400 в JSON")
+
+    print("ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ")
+
+
+if __name__ == "__main__":
+    main()
