@@ -0,0 +1,43 @@
+"""Проверка лимита запросов на /generate и модуля ratelimit (без сети)."""
+from unittest import mock
+
+import app as app_module
+import ratelimit
+
+
+def main() -> None:
+    ratelimit.reset()
+    assert all(ratelimit.allow("ip") for _ in range(10))
+    assert not ratelimit.allow("ip")
+    assert ratelimit.allow("other")
+    print("✅ ratelimit.allow: 10 в окне, 11-й отклонён, другой ключ не затронут")
+
+    with mock.patch("time.monotonic", return_value=1000.0):
+        ratelimit.reset()
+        assert all(ratelimit.allow("ip") for _ in range(10))
+    with mock.patch("time.monotonic", return_value=1061.0):
+        assert ratelimit.allow("ip")
+    print("✅ ratelimit.allow: окно скользит (через 60 с снова можно)")
+
+    ratelimit.reset()
+    c = app_module.app.test_client()
+    codes = [c.post("/generate", json={"repo": "o/r"}).status_code for _ in range(11)]
+    assert codes[:10] == [400] * 10 and codes[10] == 429, codes
+    r = c.post("/generate", json={})
+    assert r.status_code == 429 and r.is_json and "error" in r.get_json()
+    print("✅ /generate: 11-й запрос с одного IP -> JSON 429")
+
+    assert c.post("/stats", json={}).status_code == 400
+    assert c.post("/publish", json={}).status_code == 400
+    assert c.get("/health").status_code == 200
+    other = app_module.app.test_client()
+    r = other.post("/generate", json={}, environ_overrides={"REMOTE_ADDR": "10.0.0.2"})
+    assert r.status_code == 400
+    print("✅ другие эндпоинты и другие IP не затронуты")
+
+    ratelimit.reset()
+    print("\n✅ ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ — лимит запросов /generate")
+
+
+if __name__ == "__main__":
+    main()
