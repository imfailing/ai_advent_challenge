+"""Проверка activity.compute_stats (чистая функция, без сети)."""
+import activity
+
+
+def _c(date: str | None, author: str | None) -> dict:
+    return {"hash": "h", "date": date, "author": author, "subject": "x", "body": ""}
+
+
+def main() -> None:
+    e = activity.compute_stats([])
+    assert e == {"total_commits": 0, "first_date": None, "last_date": None,
+                 "top_authors": [], "commits_by_day": [], "busiest_day": None}
+    print("✅ пустой список коммитов")
+
+    tie = activity.compute_stats([_c("2024-01-01", "Bob"), _c("2024-01-01", "Ann")])
+    assert [a["author"] for a in tie["top_authors"]] == ["Ann", "Bob"]
+    assert all(a["commits"] == 1 for a in tie["top_authors"])
+    print("✅ равенство количества у авторов: порядок по имени")
+
+    tie_day = activity.compute_stats([_c("2024-01-01", "A"), _c("2024-01-02", "A")])
+    assert tie_day["busiest_day"] == {"date": "2024-01-02", "commits": 1}
+    print("✅ равенство по дням: побеждает более поздний день")
+
+    mixed = activity.compute_stats([_c("", None), _c(None, "A"), _c("2024-03-05", "A")])
+    assert mixed["total_commits"] == 3
+    assert {"author": "?", "commits": 1} in mixed["top_authors"]
+    assert mixed["commits_by_day"] == [{"date": "2024-03-05", "commits": 1}]
+    assert mixed["first_date"] == mixed["last_date"] == "2024-03-05"
+    print("✅ коммиты без даты/автора: автор '?', дата пропускается в днях")
+
+    only_nodate = activity.compute_stats([_c(None, "A")])
+    assert only_nodate["busiest_day"] is None and only_nodate["commits_by_day"] == []
+    print("✅ только коммиты без даты: busiest_day None")
+
+    many = [_c("2024-01-01", f"A{i}") for i in range(8)]
+    assert len(activity.compute_stats(many)["top_authors"]) == activity.TOP_AUTHORS
+    assert len(activity.compute_stats(many, top=2)["top_authors"]) == 2
+    assert len(activity.compute_stats(many, top=20)["top_authors"]) == 8
+    print("✅ top ограничивает число авторов (по умолчанию 5)")
+
+    by_author = activity.compute_stats([_c("2024-01-01", "A"), _c("2024-01-02", "B")], author="B")
+    assert by_author["total_commits"] == 1 and by_author["top_authors"][0]["author"] == "B"
+    assert activity.compute_stats(many, author="Nobody")["total_commits"] == 0
+    print("✅ фильтр author")
+
+    days = activity.compute_stats([_c("2024-01-03", "A"), _c("2024-01-01", "A")])
+    assert [d["date"] for d in days["commits_by_day"]] == ["2024-01-01", "2024-01-03"]
+    print("✅ commits_by_day отсортированы по возрастанию даты")
+
+    print("\n✅ ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ — activity.compute_stats")
+
+
+if __name__ == "__main__":
+    main()
