diff --git a/ratelimit.py b/ratelimit.py
new file mode 100644
index 0000000..e2bac94
--- /dev/null
+++ b/ratelimit.py
@@ -0,0 +1,27 @@
+"""
+Ограничитель частоты запросов по ключу (IP) — скользящее окно в памяти процесса.
+
+Роль в сервисе: защита дорогого `/generate` (вызов LLM) от флуда. Без Flask-импортов.
+"""
+
+import time
+from collections import deque
+
+_hits: dict[str, deque[float]] = {}
+
+
+def allow(key: str, limit: int = 10, window: float = 60.0) -> bool:
+    """Зарегистрировать запрос; False, если за последние `window` секунд уже `limit` запросов."""
+    now = time.monotonic()
+    q = _hits.setdefault(key, deque())
+    while q and now - q[0] >= window:
+        q.popleft()
+    if len(q) >= limit:
+        return False
+    q.append(now)
+    return True
+
+
+def reset() -> None:
+    """Сбросить все счётчики (для тестов)."""
+    _hits.clear()
