diff --git a/test_stats_bounds.py b/test_stats_bounds.py
new file mode 100644
index 0000000..777aabf
--- /dev/null
+++ b/test_stats_bounds.py
@@ -0,0 +1,46 @@
+"""Проверка границ параметра last у /stats (без сети, get_commits подменён)."""
+from unittest import mock
+
+import app as app_module
+
+
+def _last_passed(last) -> tuple[int, int | None]:
+    """Вернуть (код ответа, last, с которым вызван get_commits или None)."""
+    with mock.patch("github_repo.get_commits", return_value=[]) as m:
+        r = app_module.app.test_client().post("/stats", json={"repo": "o/r", "last": last})
+    return r.status_code, (m.call_args.kwargs["last"] if m.called else None)
+
+
+def main() -> None:
+    assert _last_passed(0) == (200, 15)
+    print("✅ last=0 -> falsy, берётся дефолт 15")
+
+    assert _last_passed(1) == (200, 1)
+    print("✅ last=1 -> 1")
+
+    assert _last_passed(100) == (200, 100)
+    print("✅ last=100 -> 100")
+
+    assert _last_passed(101) == (200, 100)
+    print("✅ last=101 -> ограничено до 100")
+
+    assert _last_passed("7") == (200, 7)
+    print("✅ last='7' (строка-число) -> 7")
+
+    assert _last_passed(-5) == (200, 1)
+    print("✅ last=-5 -> ограничено до 1")
+
+    code, called = _last_passed("abc")
+    assert code == 400 and called is None
+    r = app_module.app.test_client().post("/stats", json={"repo": "o/r", "last": "abc"})
+    assert r.is_json and r.get_json()["error"] == "Параметр last должен быть числом."
+    print("✅ last='abc' -> JSON 400, GitHub не вызывается")
+
+    assert _last_passed(None) == (200, 15)
+    print("✅ last=null -> дефолт 15")
+
+    print("\n✅ ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ — границы last у /stats")
+
+
+if __name__ == "__main__":
+    main()
