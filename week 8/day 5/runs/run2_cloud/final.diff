+    s = activity.compute_stats([_c("A", ""), _c("A", None), _c("A", "2024-03-05")])
+    assert s["total_commits"] == 3
+    assert s["commits_by_day"] == [{"date": "2024-03-05", "commits": 1}]
+    assert s["first_date"] == s["last_date"] == "2024-03-05"
+    print("✅ коммиты без даты считаются в total, но не попадают в дни")
+
