@@ -0,0 +1,48 @@
+"""Проверка лимита запросов 10/мин на /generate по IP (без сети)."""
+from unittest import mock
+
+import app as app_module
+import ratelimit
+
+
+def _post(client, ip: str, path: str = "/generate"):
+    return client.post(path, json={}, environ_base={"REMOTE_ADDR": ip})
+
+
+def main() -> None:
+    ratelimit.reset()
+    with mock.patch("time.monotonic", return_value=1000.0):
+        assert all(ratelimit.allow("k") for _ in range(10))
+        assert not ratelimit.allow("k")
+        assert ratelimit.allow("other")
+    with mock.patch("time.monotonic", return_value=1059.0):
+        assert not ratelimit.allow("k")
+    with mock.patch("time.monotonic", return_value=1060.5):
+        assert ratelimit.allow("k")
+    print("✅ ratelimit.allow: 10 в окне, 11-й отказ, другой ключ независим, окно 60 с")
+
+    ratelimit.reset()
+    client = app_module.app.test_client()
+    with mock.patch("time.monotonic", return_value=5.0):
+        for i in range(10):
+            r = _post(client, "1.1.1.1")
+            assert r.status_code == 400, i
+        r = _post(client, "1.1.1.1")
+        assert r.status_code == 429 and r.is_json and r.get_json()["error"]
+        print("✅ /generate: 11-й запрос с одного IP -> JSON 429")
+
+        assert _post(client, "2.2.2.2").status_code == 400
+        print("✅ другой IP не затронут")
+
+        for path in ("/stats", "/publish"):
+            for _ in range(12):
+                assert _post(client, "1.1.1.1", path).status_code != 429, path
+        assert client.get("/health", environ_base={"REMOTE_ADDR": "1.1.1.1"}).status_code == 200
+        print("✅ /stats, /publish, /health лимитом не затронуты")
+    ratelimit.reset()
+
+    print("\n✅ ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ — лимит 10 запросов/мин на /generate")
+
+
+if __name__ == "__main__":
+    main()
