+"""Проверка: тело `null` на POST-маршрутах даёт JSON 400, а не HTML 500 (без сети)."""
+from unittest import mock
+
+import app as app_module
+
+
+def main() -> None:
+    c = app_module.app.test_client()
+    with mock.patch.dict(app_module._last_digest, {"md": "TXT"}):
+        for path in ("/generate", "/stats", "/publish"):
+            r = c.post(path, data="null", content_type="application/json")
+            assert r.is_json, path
+            if path == "/publish":
+                assert r.status_code == 200 and r.get_json()["status"] == "skipped"
+            else:
+                assert r.status_code == 400 and "error" in r.get_json(), path
+            print(f"✅ {path}: тело null -> JSON")
+    with mock.patch.dict(app_module._last_digest, {"md": ""}):
+        r = c.post("/publish", data="null", content_type="application/json")
+    assert r.status_code == 400 and r.is_json
+    print("✅ /publish без результата и с null -> JSON 400")
+    print("\n✅ ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ — тело null не роняет маршруты")
+
+
+if __name__ == "__main__":
+    main()
