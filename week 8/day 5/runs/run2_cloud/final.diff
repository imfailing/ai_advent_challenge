@@ -0,0 +1,49 @@
+"""Проверка границ параметра last у /stats (без сети, get_commits подменён)."""
+from unittest import mock
+
+import app as app_module
+
+COMMITS = [{"hash": "a", "date": "2024-01-01", "author": "Ann", "subject": "x", "body": ""}]
+
+
+def _last_used(client, last) -> tuple[int, int | None]:
+    """Вернуть (код ответа, last, с которым вызван get_commits или None)."""
+    with mock.patch("github_repo.get_commits", return_value=COMMITS) as gc:
+        r = client.post("/stats", json={"repo": "o/r", "last": last})
+    used = gc.call_args.kwargs["last"] if gc.called else None
+    return r.status_code, used
+
+
+def main() -> None:
+    c = app_module.app.test_client()
+
+    assert _last_used(c, 0) == (200, 15)
+    print("✅ last=0 -> значение по умолчанию 15")
+    assert _last_used(c, 1) == (200, 1)
+    print("✅ last=1 -> 1")
+    assert _last_used(c, 100) == (200, 100)
+    print("✅ last=100 -> 100")
+    assert _last_used(c, 101) == (200, 100)
+    print("✅ last=101 -> клампится до 100")
+    assert _last_used(c, "7") == (200, 7)
+    print("✅ last='7' (строка-число) -> 7")
+    assert _last_used(c, "abc") == (400, None)
+    print("✅ last='abc' -> 400, GitHub не вызывается")
+    assert _last_used(c, -5) == (200, 1)
+    print("✅ last=-5 -> клампится до 1")
+
+    with mock.patch("github_repo.get_commits", return_value=COMMITS) as gc:
+        r = c.post("/stats", json={"repo": "o/r"})
+    assert r.status_code == 200 and gc.call_args.kwargs["last"] == 15
+    print("✅ без last -> 15")
+
+    with mock.patch("github_repo.get_commits", return_value=COMMITS):
+        r = c.post("/stats", json={"repo": "o/r", "last": "abc"})
+    assert r.is_json and r.get_json()["error"] == "Параметр last должен быть числом."
+    print("✅ ошибка нечислового last — JSON с текстом по-русски")
+
+    print("\n✅ ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ — границы last в /stats")
+
+
+if __name__ == "__main__":
+    main()
