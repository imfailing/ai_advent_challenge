+"""
+Лимит частоты запросов по ключу (IP): скользящее окно в памяти процесса.
+
+Роль в сервисе: защита дорогого `/generate` (вызов LLM) от флуда. Модуль не знает
+про Flask — маршрут передаёт сюда IP и сам формирует ответ 429.
+"""
+
+import time
+from collections import deque
+
+LIMIT = 10      # запросов
+WINDOW = 60.0   # секунд
+
+_hits: dict[str, deque[float]] = {}
+
+
+def allow(key: str, limit: int = LIMIT, window: float = WINDOW) -> bool:
+    """Учесть запрос от key; False, если за последние window секунд уже было limit запросов."""
+    now = time.monotonic()
+    hits = _hits.setdefault(key, deque())
+    while hits and now - hits[0] >= window:
+        hits.popleft()
+    if len(hits) >= limit:
+        return False
+    hits.append(now)
+    return True
+
+
+def reset() -> None:
+    """Сбросить все счётчики (для тестов)."""
+    _hits.clear()
